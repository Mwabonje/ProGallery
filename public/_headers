# HTTP Security & Robots Headers for Mwabonje Photography

# Private Client Galleries
/g/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet
  Cache-Control: private, no-cache, no-store, must-revalidate

# Gallery Management & Photographer Portal
/gallery/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet
  Cache-Control: private, no-cache, no-store, must-revalidate

# Dashboard
/dashboard
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet
  Cache-Control: private, no-cache, no-store, must-revalidate

/dashboard/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet
  Cache-Control: private, no-cache, no-store, must-revalidate

# Admin & Login
/admin
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet
